{
  "name": "tactivar",
  "private": true,
  "description": "TactiVAR Manager – fodboldmanager med VAR-tema, skjulte evner og scouting via kampreferater. Firebase Hosting.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "check": "node tools/check.mjs",
    "serve": "node tools/serve.mjs",
    "emulators": "firebase emulators:start --only auth,hosting,firestore",
    "deploy": "firebase deploy --only hosting,firestore:rules",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-tactivar \"node tests/rules/run.mjs\""
  },
  "devDependencies": {
    "firebase-tools": "^15.34.1",
    "playwright-core": "^1.55.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
